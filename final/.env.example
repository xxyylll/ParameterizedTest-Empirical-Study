# 复制为 .env 或直接 export。四个变量都可选，不设则用各自的默认值。

# 外置盘根目录：包含 apache-projects/（源码快照 + 各项目的 AAA/）、
# dup_result_ssk/（CCFinderSW 输出）、rq2.2_manual/（人工标注表）
export PT_SSD=/Volumes/SSKSSD

# 轻量 parser 的逐项目 JSON（243 个 *_output.json）
export PT_PARSER_SSK=/path/to/parser_result_ssk

# RQ3 的指标中间表目录（test_metrics_all_46projects_v2.csv 等）
export PT_METRICS=/path/to/metrics

# 人工标注表目录，默认 $PT_SSD/rq2.2_manual
export PT_MANUAL=/Volumes/SSKSSD/rq2.2_manual
