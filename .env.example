# Copy to .env (git-ignored) or export these in your shell. All are optional;
# without them every path defaults to <repo>/data/... (see paths.py).

# Root of the external drive: apache-projects/ (source snapshots + per-project AAA/),
# dup_result_ssk/ (CCFinderSW output), rq2.2_manual/ (manual coding table)
export PT_SSD=/path/to/ssd

# Lightweight-parser JSON per project (243 *_output.json)
export PT_PARSER_SSK=/path/to/parser_result_ssk

# RQ3 metric tables (test_metrics_all_46projects_v2.csv, test_helper_detail_46projects.csv).
# If unset and missing, rq3/code/run_rq3.sh unpacks the bundled .gz files.
export PT_METRICS=/path/to/metrics

# PDAR stage-1 per-commit tables (189 MB)
export PT_PDAR_RESULT=/path/to/pdar_stage1

# Manual coding table for RQ2.2 (default: $PT_SSD/rq2.2_manual)
# export PT_MANUAL=/path/to/rq2.2_manual

# RQ2.2 pipeline: deep-parser fat jar (provides JDT) and a JDK 21 java binary
export PT_AAA_JAR=/path/to/Javalang-analyzing-cli-1.3.2-all.jar
export PT_JAVA=java
